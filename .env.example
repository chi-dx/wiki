# Defaults run entirely locally with visibly fictional material.
DATA_DIR=data
WIKI_MODE=demo
EXTERNAL_MODE=demo
MODEL_MODE=extractive
# Karpathy-style derived wiki: extractive works offline; llm compiles with the model API.
COMPILE_MODE=extractive
COMPILE_TIMEOUT_SECONDS=90
EXTERNAL_DEFAULT=true
SYNC_INTERVAL_SECONDS=300
REQUEST_TIMEOUT_SECONDS=25
UPSTREAM_TIMEOUT_SECONDS=8
MAX_CONCURRENT_ASKS=4
# WIKI_MODE=http: GET returns the complete authoritative snapshot documented in docs/running.md.
WIKI_URL=
WIKI_API_KEY=
# EXTERNAL_MODE=http: POST {"question": "...", "limit": 4}
EXTERNAL_URL=
EXTERNAL_API_KEY=
# MODEL_MODE=openai: full OpenAI-compatible chat completions endpoint, not a base URL.
MODEL_URL=
MODEL_API_KEY=
MODEL_NAME=

# Real compiler trial (see docs/compiler-trial.md).
# Switch to compiler only after starting the Node bridge.
KNOWLEDGE_BACKEND=local
COMPILER_URL=http://127.0.0.1:8010
COMPILER_QUERY_TIMEOUT_SECONDS=180
COMPILER_SYNC_TIMEOUT_SECONDS=900
COMPILER_ROOT=data/upstream-compiler
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
